<?xml version="1.0" encoding="utf-8"?>
<!--
  C:\inetpub\wwwroot\Develop\web.config
  Makes http://server/Develop/ open Devidx.html (instead of looking for index.html).
-->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="Devidx.html" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
